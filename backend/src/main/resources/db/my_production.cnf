# ==============================================================================================
# CHOPEE MARKETPLACE - ENTERPRISE MYSQL 8.0 PRODUCTION TUNING CONFIGURATION (my_production.cnf)
# Target Architecture: High-Concurrency Multi-Vendor E-Commerce (10,000+ QPS, Flash Sales)
# Recommended Server Specs: 16-32 vCPU, 32-64 GB RAM, Enterprise NVMe SSD Storage
# ==============================================================================================

[client]
default-character-set = utf8mb4
port = 3306
socket = /var/run/mysqld/mysqld.sock

[mysql]
default-character-set = utf8mb4

[mysqld]
# ----------------------------------------------------------------------------------------------
# 1. GENERAL & CHARACTER SET
# ----------------------------------------------------------------------------------------------
user                            = mysql
port                            = 3306
default_storage_engine          = InnoDB
character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci
explicit_defaults_for_timestamp = 1
event_scheduler                 = ON

# ----------------------------------------------------------------------------------------------
# 2. CONNECTION & THREAD MANAGEMENT
# ----------------------------------------------------------------------------------------------
max_connections                 = 1000
max_connect_errors              = 1000000
back_log                        = 512
thread_cache_size               = 128
thread_stack                    = 256K
interactive_timeout             = 180
wait_timeout                    = 180
max_allowed_packet              = 64M

# ----------------------------------------------------------------------------------------------
# 3. INNODB BUFFER POOL & CACHING (CỐT LÕI TẦNG NÓNG - HOT TIER RAM)
# ----------------------------------------------------------------------------------------------
# Gán 70% - 75% RAM máy chủ cho Buffer Pool (Ví dụ máy chủ 32GB RAM => 24GB)
innodb_buffer_pool_size         = 24G
innodb_buffer_pool_instances     = 8
innodb_buffer_pool_dump_at_shutdown = 1
innodb_buffer_pool_load_at_startup  = 1

# ----------------------------------------------------------------------------------------------
# 4. INNODB LOGGING & I/O OPTIMIZATION (TỐI ƯU HÓA GHI TRONG FLASH SALE)
# ----------------------------------------------------------------------------------------------
innodb_log_file_size            = 1G
innodb_log_files_in_group       = 2
innodb_log_buffer_size          = 64M

# Giá trị 2 giúp tăng tốc độ chốt đơn lên 20x - 50x so với giá trị 1, dữ liệu an toàn trong bộ đệm OS
innodb_flush_log_at_trx_commit  = 2

# Tối ưu hóa I/O cho ổ đĩa SSD NVMe Enterprise
innodb_io_capacity              = 5000
innodb_io_capacity_max          = 10000
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8
innodb_flush_method             = O_DIRECT
innodb_file_per_table           = 1

# ----------------------------------------------------------------------------------------------
# 5. TABLE & METADATA CACHE
# ----------------------------------------------------------------------------------------------
table_open_cache                = 4096
table_definition_cache          = 2048
open_files_limit                = 65535

# ----------------------------------------------------------------------------------------------
# 6. TEMPORARY TABLES & SORTS
# ----------------------------------------------------------------------------------------------
tmp_table_size                  = 64M
max_heap_table_size             = 64M
sort_buffer_size                = 4M
join_buffer_size                = 4M
read_rnd_buffer_size            = 2M

# ----------------------------------------------------------------------------------------------
# 7. SLOW QUERY LOGGING (GIÁM SÁT NGHẼN CỔ CHAI)
# ----------------------------------------------------------------------------------------------
slow_query_log                  = 1
slow_query_log_file             = /var/log/mysql/mysql-slow.log
long_query_time                 = 0.5
log_queries_not_using_indexes   = 0

# ----------------------------------------------------------------------------------------------
# 8. FULL-TEXT SEARCH N-GRAM TOKENIZER (TỐI ƯU TÌM KIẾM TIẾNG VIỆT CÓ DẤU)
# ----------------------------------------------------------------------------------------------
ngram_token_size                = 2
ft_min_word_len                 = 2
innodb_ft_min_token_size        = 2
